<UserControl x:Class="Visualizer.App.UI.MeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="44">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="12" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="LabelText"
                       Foreground="#BFC7D5"
                       FontSize="12"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ValueText"
                       Foreground="#7E8797"
                       FontSize="11"
                       HorizontalAlignment="Right"
                       TextAlignment="Right" />
        </DockPanel>
        <Border Grid.Row="1"
                Background="#20242D"
                CornerRadius="2"
                ClipToBounds="True">
            <Grid>
                <Rectangle x:Name="Fill"
                           Fill="#49E5D7"
                           HorizontalAlignment="Left"
                           Width="0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
